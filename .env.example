# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# YouTube channel info
YOUTUBE_CHANNEL_ID=

# Google Drive folder IDs
# (get these from each folder's URL: drive.google.com/drive/folders/<THIS_PART>)

# Folder you drop new VOD files into
DRIVE_IMPORT_FOLDER_ID=

# Folder files get moved to after a successful upload
DRIVE_UPLOADED_FOLDER_ID=

# How often to check the import folder for new files (cron expression)
# Default: every hour
CHECK_CRON=0 * * * *

# How often to run the cleanup job that deletes old files from the "uploaded" folder
# Default: once a day at 03:00
CLEANUP_CRON=0 3 * * *

# How many days a file stays in the "uploaded" folder before being deleted
CLEANUP_AFTER_DAYS=3

# Publish schedule settings
# Time of day (24h, server timezone) videos should go public
PUBLISH_HOUR=19
PUBLISH_MINUTE=0

# How many days ahead to schedule if today's slot is taken
DAYS_BETWEEN_UPLOADS=1
