# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# YouTube channel info
YOUTUBE_CHANNEL_ID=

# Google Drive folder ID to watch for new VODs
# (get this from the folder's URL: drive.google.com/drive/folders/<THIS_PART>)
DRIVE_WATCH_FOLDER_ID=

# Optional: folder to move successfully uploaded files to (instead of deleting)
DRIVE_UPLOADED_FOLDER_ID=

# Upload schedule: cron expression for how often to check Drive for new files
# Default: every hour
CHECK_CRON=0 * * * *

# Publish schedule settings
# Time of day (24h, server timezone) videos should go public
PUBLISH_HOUR=18
PUBLISH_MINUTE=0

# How many days ahead to schedule if today's slot is taken
DAYS_BETWEEN_UPLOADS=1
